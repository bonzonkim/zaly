Require bun

Set Shell "bash"
# 900 × 600 logical pixels at 2× density; scale dimensions, font, and padding together.
Set Width 1800
Set Height 1200
Set FontFamily "JetBrains Mono"
Set FontSize 40
Set LineHeight 1.1
Set Padding 48
Set Theme "TokyoNight"
Set TypingSpeed 35ms
Set Framerate 30
Set WaitTimeout 20s

Env TERM "xterm-256color"
Env COLORTERM "truecolor"
Env PS1 "❯ "
Env PROMPT_COMMAND ""
Env BASH_ENV "/dev/null"
